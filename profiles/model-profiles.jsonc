{
  // Verification status per harness. Re-check with the listed command and update
  // scripts/run-agent.sh in the same change; scripts/verify.sh compares the model IDs in
  // this file against that script and reports drift as a warning (it does not fail the run).
  //
  // claude    VERIFIED 2026-09-08 against `claude --help` (CLI 2.1.266): --model accepts the
  //           aliases opus/sonnet/fable, --effort accepts low|medium|high|xhigh|max, and the
  //           two --permission-mode values used by run-agent.sh (plan, auto) are both in its
  //           accepted set (acceptEdits, auto, bypassPermissions, manual, dontAsk, plan).
  // opencode  VERIFIED 2026-08-21 against `opencode models` output.
  // copilot   VERIFIED 2026-09-09 against `copilot help config`, which lists the accepted
  //           `model` values. --effort accepts low|medium|high|xhigh.
  // antigravity VERIFIED 2026-09-28 against `agy models` (CLI 1.2.12). Its IDs already encode the
  //           reasoning level as a suffix (-high/-medium/-low), so run-agent.sh sets the level by
  //           choosing the ID and does not also pass --effort. `--agent` (added in 1.1.1) forwards
  //           the selected custom agent at launch.
  // codex VERIFIED 2026-09-24 against `codex --help` (CLI 0.156.1); uses the configured model
  // and `model_reasoning_effort` overrides instead of pinning a model ID.
  "defaultProfile": "balanced",
  "profiles": {
    "deep": {
      "purpose": "Architecture, hard debugging, critical reviews.",
      "claude": {
        "model": "opus",
        "effort": "high"
      },
      "copilot": {
        "model": "claude-opus-4.7",
        "effort": "high"
      },
      "opencode": {
        "model": "anthropic/claude-opus-5"
      },
      "antigravity": {
        "model": "gemini-3.1-pro-high"
      },
      "codex": {
        "effort": "high"
      }
    },
    "balanced": {
      "purpose": "Daily coding, review, and documentation work.",
      "claude": {
        "model": "sonnet",
        "effort": "medium"
      },
      "copilot": {
        "model": "gpt-5.4",
        "effort": "medium"
      },
      "opencode": {
        "model": "anthropic/claude-sonnet-5"
      },
      "antigravity": {
        "model": "gemini-3.8-flash-medium"
      },
      "codex": {
        "effort": "medium"
      }
    },
    "fast": {
      "purpose": "Small edits, quick docs, and low-risk checks.",
      "claude": {
        "model": "fable",
        "effort": "low"
      },
      "copilot": {
        "model": "gpt-5.4-mini",
        "effort": "low"
      },
      "opencode": {
        "model": "anthropic/claude-haiku-4-5"
      },
      "antigravity": {
        "model": "gemini-3.8-flash-low"
      },
      "codex": {
        "effort": "low"
      }
    }
  }
}
