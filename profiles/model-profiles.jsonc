{
  // opencode model IDs are verified against `opencode models` output as of 2026-08-21.
  // copilot model IDs are NOT independently verified here (no authenticated `copilot` session
  // was available to query its model catalog) — recheck against `copilot --help` / `/model`
  // periodically and update alongside scripts/run-agent.sh.
  // antigravity model IDs are NOT verified (no authenticated `agy` session) — confirm against
  // `agy --help` / the model catalog and update alongside scripts/run-agent.sh.
  "defaultProfile": "balanced",
  "profiles": {
    "deep": {
      "purpose": "Architecture, hard debugging, critical reviews.",
      "claude": {
        "model": "opus",
        "effort": "high"
      },
      "copilot": {
        "model": "claude-opus-4.8",
        "effort": "high"
      },
      "opencode": {
        "model": "anthropic/claude-opus-5"
      },
      "antigravity": {
        "model": "Gemini 3.5 Pro"
      }
    },
    "balanced": {
      "purpose": "Daily coding, review, and documentation work.",
      "claude": {
        "model": "sonnet",
        "effort": "medium"
      },
      "copilot": {
        "model": "gpt-5.5",
        "effort": "medium"
      },
      "opencode": {
        "model": "anthropic/claude-sonnet-5"
      },
      "antigravity": {
        "model": "Gemini 3.5 Flash"
      }
    },
    "fast": {
      "purpose": "Small edits, quick docs, and low-risk checks.",
      "claude": {
        "model": "fable",
        "effort": "low"
      },
      "copilot": {
        "model": "gpt-5.4-mini",
        "effort": "low"
      },
      "opencode": {
        "model": "anthropic/claude-haiku-4-5"
      },
      "antigravity": {
        "model": "Gemini 3.5 Flash"
      }
    }
  }
}
